{
  "manifest_version": 3,
  "name": "CTU Registration Assistant",
  "version": "0.1.0",
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "host_permissions": [
    "https://dkmhfe.ctu.edu.vn/*",
    "https://www.google.com/*",
    "https://www.cloudflare.com/*",
    "https://www.microsoft.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://dkmhfe.ctu.edu.vn/dangkyhocphan/sinhvien/dangkyhocphan*"],
      "js": [
        "src/content/precision-scheduler.js",
        "src/content/registration-adapter.js",
        "src/content/registration-page.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
